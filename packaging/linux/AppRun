#!/bin/sh
# Starts Krabton from the AppImage. The system's ALSA library is used when
# there is one (it knows the system's sound setup); otherwise the copy that
# ships in the AppImage, so Krabton still starts (and plays through
# PulseAudio / PipeWire, which it loads itself).
here="$(dirname "$(readlink -f "$0")")"
if ! { ldconfig -p 2>/dev/null | grep -q 'libasound\.so\.2 '; } && [ ! -e /usr/lib/libasound.so.2 ] && [ ! -e /usr/lib64/libasound.so.2 ] && [ ! -e /usr/lib/x86_64-linux-gnu/libasound.so.2 ]; then
    export LD_LIBRARY_PATH="$here/usr/lib/fallback${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
exec "$here/usr/bin/krabton" "$@"
