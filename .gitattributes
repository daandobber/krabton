# Normalize text files to LF in the repository.
* text=auto

# Sample data and images must never be converted.
*.bin binary
*.png binary
*.wav binary
*.syx binary
*.ico binary
*.icns binary
*.rgba binary
*.raw binary

# Scripts and packaging files stay LF everywhere.
*.sh text eol=lf
PKGBUILD text eol=lf
AppRun text eol=lf
*.desktop text eol=lf
